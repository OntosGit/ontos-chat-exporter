{
  "manifest_version": 3,
  "name": "ONTOS Chat Exporter",
  "version": "1.3.1",
  "description": "Сохранение одной беседы ChatGPT в Markdown, HTML или JSON. Локально, без прокрутки.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "live.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "ONTOS · Архив беседы",
    "default_popup": "popup.html"
  }
}
