{
  "manifest_version": 3,
  "name": "ONTOS Chat Exporter",
  "version": "1.4.0",
  "description": "Возобновляемый экспорт беседы ChatGPT с контрольными точками каждой страницы. Markdown, HTML, JSON.",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "checkpoints.js",
        "live.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "ONTOS · Архив беседы",
    "default_popup": "popup.html"
  }
}
